# Copy to .env and fill in. Never commit .env.
# Locally, set secrets directly. In Lambda, set the *_SSM_PARAM names instead.
HF_TOKEN=
# HF_TOKEN_SSM_PARAM=/biomecha-rag/hf-token
PINECONE_API_KEY=
# PINECONE_API_KEY_SSM_PARAM=/biomecha-rag/pinecone-api-key

# Hugging Face Inference Endpoints (Text Embeddings Inference for BGE, TGI for Mistral-7B)
EMBED_ENDPOINT_URL=
RERANK_ENDPOINT_URL=
LLM_ENDPOINT_URL=

PINECONE_INDEX=biomecha-rag
PINECONE_NAMESPACE=sports-science
BM25_PARAMS_PATH=bm25_params.json

HYBRID_ALPHA=0.5
RETRIEVE_TOP_K=20
RERANK_TOP_N=5
MAX_NEW_TOKENS=512
TEMPERATURE=0.1
